{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Relay": {
    "MaxPayloadBytes": 1048576,
    "MaxEnvelopeBytes": 2097152,
    "DefaultTtlSeconds": 600,
    "MinTtlSeconds": 30,
    "MaxTtlSeconds": 3600,
    "DefaultMaxDownloads": 10,
    "MaxDownloads": 100,
    "MaxTotalBytes": 268435456,
    "MaxTransfers": 10000,
    "CleanupIntervalSeconds": 30,
    "RequireHttps": false
  }
}
